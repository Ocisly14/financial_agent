{
  "name": "financial-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tools:list": "node --env-file=.env --experimental-strip-types --experimental-sqlite -e \"import('./mcp_tools/index.ts').then(m => { const r = new m.McpToolRegistry(); m.registerAllTools(r); console.log(r.list().map(t => t.name).join('\\n')); })\"",
    "build": "tsc -p tsconfig.json",
    "test:agent": "node --env-file=.env --experimental-strip-types --experimental-sqlite scripts/test-agent.ts",
    "build:client": "pnpm --prefix client install && pnpm --prefix client build",
    "start:client": "pnpm --prefix client dev",
    "start": "node --env-file=.env --experimental-strip-types --experimental-sqlite src/server.ts",
    "dev": "node --env-file=.env --experimental-strip-types --experimental-sqlite --watch src/server.ts",
    "test": "node --env-file=.env --experimental-strip-types --experimental-sqlite --test \"mcp_tools/**/__tests__/*.test.ts\"",
    "eval": "node --env-file=.env --experimental-strip-types --experimental-sqlite scripts/eval/run.ts",
    "eval:nl-dsl": "node --env-file=.env --experimental-strip-types --experimental-sqlite scripts/eval/nl-dsl.ts"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.4",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "2.1.10",
    "@tavily/core": "^0.3.0",
    "ai": "4.1.54",
    "mongodb": "^7.3.0",
    "zod": "^3"
  },
  "packageManager": "pnpm@10.7.1"
}
