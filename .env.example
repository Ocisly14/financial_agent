# ================================
# Financial Agent — Environment Variables
# Copy this file to .env and fill in the values.
# ================================

# --------------------------------
# LLM Provider (required — pick one)
# --------------------------------
LLM_PROVIDER=anthropic               # anthropic | openai | google | vertex

ANTHROPIC_API_KEY=                   # claude-sonnet-4-5 / claude-opus-4 etc.
OPENAI_API_KEY=                      # gpt-4o etc.
GOOGLE_API_KEY=                      # Gemini (AI Studio API key — consumer path)

# Google Gemini via Vertex AI (service-account auth — preferred over API key).
# When GOOGLE_VERTEX_PROJECT is set, LLM_PROVIDER=google auto-uses Vertex.
GOOGLE_VERTEX_PROJECT=               # GCP project ID
GOOGLE_VERTEX_LOCATION=global        # e.g. global (default for Gemini access)
GOOGLE_APPLICATION_CREDENTIALS_JSON= # entire service account JSON as one line

# Model class overrides (optional — defaults shown)
LLM_MODEL_SMALL=claude-haiku-4-5-20251001
LLM_MODEL_MEDIUM=claude-sonnet-4-6
LLM_MODEL_LARGE=claude-opus-4-8

# --------------------------------
# Market Data
# --------------------------------

# Public Binance market-data host (klines/ticker/depth for charts & strategy
# polling). No API key. Defaults to data-api.binance.vision (Binance's official
# mirror, NOT geo-restricted). Set to https://api.binance.com only if your
# region prefers the main host. Optional.
BINANCE_DATA_BASE=

# --------------------------------
# Tavily Search (financial_search)
# --------------------------------
TAVILY_API_KEY=                      # Primary key — https://tavily.com
TAVILY_API_KEY_1=                    # Optional key rotation slot 1
TAVILY_API_KEY_2=                    # Optional key rotation slot 2
TAVILY_API_KEY_3=                    # Optional key rotation slot 3

# --------------------------------
# Chart output
# --------------------------------

# --------------------------------
# CEX Trading — Binance (default exchange)
# --------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --------------------------------
# CEX Trading — Coinbase Advanced Trade
# --------------------------------
# api_key_name format: "organizations/{org_id}/apiKeys/{key_id}"
COINBASE_API_KEY_NAME=
COINBASE_PRIVATE_KEY=                # EC private key PEM (multi-line or \n-escaped)

# --------------------------------
# Server
# --------------------------------
SERVER_PORT=3000
SERVER_URL=http://localhost

CORS_ORIGIN=                         # e.g. https://yourdomain.com (leave blank for local dev)
SSE_KEEPALIVE_INTERVAL=15000
STREAM_TIMEOUT=600000

# --------------------------------
# Alpaca — US stock market data
# --------------------------------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
STOCK_DB_PATH=data/stock.db             # 本地日 K 库文件；目录不存在会自动创建
