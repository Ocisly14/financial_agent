# Financial Agent environment variables
# Copy this file to .env, then configure one LLM provider.

# -----------------------------------------------------------------------------
# LLM provider — choose anthropic, google, or vertex.
# Leave LLM_PROVIDER unset only when you intentionally want the local mock.
# -----------------------------------------------------------------------------
LLM_PROVIDER=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini through AI Studio
GOOGLE_GENERATIVE_AI_API_KEY=

# Google Gemini through Vertex AI
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
# Entire Google service-account JSON object encoded on one line.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Optional model overrides. IDs must be supported by the selected provider.
# Keep these variables unset to use each provider's built-in defaults.
# LLM_MODEL_SMALL=
# LLM_MODEL_MEDIUM=
# LLM_MODEL_LARGE=

# -----------------------------------------------------------------------------
# Tavily — current financial and web research (optional)
# -----------------------------------------------------------------------------
TAVILY_API_KEY=
# Optional rotation keys; slots are read consecutively.
TAVILY_API_KEY_1=
TAVILY_API_KEY_2=
TAVILY_API_KEY_3=

# -----------------------------------------------------------------------------
# SEC EDGAR — official company metadata, filings, and XBRL facts (optional)
# No API key is required. SEC policy requires an identifiable User-Agent with a
# contact email for automated access.
# -----------------------------------------------------------------------------
# Example: FinancialAgent your-team@example.com
SEC_USER_AGENT=

# -----------------------------------------------------------------------------
# Arelle companion — filing-level XBRL extraction (required for DCF models)
# Python interpreter running scripts/xbrl/arelle_companion.py. It needs
# arelle-release installed:
#   python3 -m venv .venv && .venv/bin/pip install arelle-release
# Unset, extraction fails with xbrl_runtime_unavailable.
# -----------------------------------------------------------------------------
ARELLE_ADAPTER_COMMAND=./.venv/bin/python
# Optional JSON string array overriding the interpreter's arguments. Leave unset:
# the default already points at the companion that ships with this repo. An
# override that omits the companion script spawns a bare interpreter, which
# silently exits 0 with no output.
ARELLE_ADAPTER_ARGS=

# Filing insights — a SMALL-model read of the 10-K narrative, one call per ~80k
# chunk per filing. Off unless set to exactly 1. Off, extraction still links an
# insight set, but an empty one flagged filing_insights_disabled.
FILING_INSIGHTS_ENABLED=

# -----------------------------------------------------------------------------
# Alpaca — live US stock/ETF quotes and bars (optional)
# -----------------------------------------------------------------------------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
STOCK_DB_PATH=data/stock.db

# -----------------------------------------------------------------------------
# Server and local persistence
# -----------------------------------------------------------------------------
SERVER_PORT=3000
# Optional Vite dev override, for example http://localhost:3000.
SERVER_BASE_URL=
SESSION_DB_PATH=data/sessions.sqlite
SSE_KEEPALIVE_INTERVAL=15000
